# ─────────────────────────────────────────────
#  Tonix Agent — Environment Configuration
# ─────────────────────────────────────────────

# Slack outbound webhook URL (get from api.slack.com/apps)
# Leave as-is to disable Slack, or paste your real webhook URL.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel name for notifications (include the #)
SLACK_CHANNEL=#pentest-alerts

# Ollama settings (runs locally, do not change unless custom port)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Report output directory (absolute path or relative to project root)
REPORTS_DIR=./reports

# FastAPI backend port
BACKEND_PORT=8000

# Frontend dev server port
FRONTEND_PORT=3000

# Rate limit for Error & Exceptions module (requests per second)
ERROR_MODULE_RATE_LIMIT=5

# Optional: an email/username KNOWN to exist on the target, used by the
# username-enumeration module's reliable login-form differential check.
# Leave blank if unknown (the module falls back to message-based detection).
# Tip: prefer passing "known_account_email" per-scan in the API request when
# you scan multiple targets. This value is a global fallback.
USERNAME_ENUM_KNOWN_ACCOUNT=

# SQLite database path
DATABASE_PATH=./backend/database/pentest_agent.db

# Katana crawler settings
KATANA_JS_CRAWL=True
